{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadCode",
  "version": "0.3.20260415",
  "identifier": "com.dsyang.readcode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReadCode",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDQTQwMkY1MzQxNDdCMTMKUldRVGV4UTA5UUtrVEV5L3NYV2pOQThHaVpBZzZPbG5RRkxuTE1nR2FGRi9JVHNtRkNvbjh3K2YK",
      "endpoints": [
        "https://dsyang.github.io/readcode/latest.json"
      ]
    }
  }
}
